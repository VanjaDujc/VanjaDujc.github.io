---
// Builds every page in every language from the content in src/content.
// A product, recipe or news item that has no file in a language simply doesn't exist there.
import { getCollection, render, type CollectionEntry } from 'astro:content';
import { marked } from 'marked';
import Base from '../layouts/Base.astro';
import ContactMap from '../components/ContactMap.astro';
import Gallery from '../components/Gallery.astro';
import Markdown from '../components/Markdown.astro';
import ProductList from '../components/ProductList.astro';
import Shelf from '../components/Shelf.astro';
import Sprig from '../components/Sprig.astro';
import TasteProfile from '../components/TasteProfile.astro';
import {
  CONTACT,
  LOCALES,
  PAGE_PATHS,
  formatDate,
  localePrefix,
  localeUrl,
  pageUrl,
  splitId,
  ui,
  type Locale,
  type PageKey,
} from '../i18n';

type Route = {
  key: string;
  locale: Locale;
  path: string;
  view: PageKey | 'product' | 'recipe' | 'newsItem';
  entry: CollectionEntry<'pages' | 'products' | 'recipes' | 'news'>;
};

export async function getStaticPaths() {
  const routes: Route[] = [];
  for (const entry of await getCollection('pages')) {
    const { locale, slug } = splitId(entry.id);
    if (!(slug in PAGE_PATHS)) continue;
    const page = slug as PageKey;
    routes.push({ key: `page:${page}`, locale, path: PAGE_PATHS[page], view: page, entry });
  }
  const details = [
    ['products', 'product'],
    ['recipes', 'recipe'],
    ['news', 'newsItem'],
  ] as const;
  for (const [collection, view] of details) {
    for (const entry of await getCollection(collection)) {
      const { locale, slug } = splitId(entry.id);
      routes.push({ key: `${view}:${slug}`, locale, path: `${collection}/${slug}/`, view, entry });
    }
  }

  return routes.map((route) => {
    const alternates = Object.fromEntries(
      LOCALES.map((l) => {
        const match = routes.find((r) => r.key === route.key && r.locale === l);
        return [l, match ? localeUrl(l, match.path) : localePrefix(l)];
      }),
    ) as Record<Locale, string>;
    const url = localeUrl(route.locale, route.path);
    return {
      params: { path: url.replace(/^\/|\/$/g, '') || undefined },
      props: { route, alternates },
    };
  });
}

const { route, alternates } = Astro.props as { route: Route; alternates: Record<Locale, string> };
const { locale, view, entry } = route;
const t = ui[locale];

const ofLocale = <T extends { id: string }>(items: T[]) => items.filter((e) => splitId(e.id).locale === locale);
const slugOf = (e: { id: string }) => splitId(e.id).slug;
const pageEntry = async (page: PageKey) =>
  (await getCollection('pages')).find((p) => p.id === `${locale}/${page}`) as CollectionEntry<'pages'>;
const plainText = (markdown = '') =>
  (marked.parse(markdown) as string)
    .replace(/<[^>]+>/g, ' ')
    .replace(/&(#39|quot|amp|lt|gt);/g, (m, e) => ({ '#39': "'", quot: '"', amp: '&', lt: '<', gt: '>' })[e as string]!)
    .replace(/\s+/g, ' ')
    .trim();
const excerpt = (markdown = '', length = 230) => {
  const text = plainText(markdown);
  return text.length > length ? text.slice(0, text.lastIndexOf(' ', length)) : text;
};

const { Content, headings } = await render(entry);

// Fixed page data, and for detail pages the page they belong to (for heading, menu and side photo)
const parentPage: Record<string, PageKey> = { product: 'products', recipe: 'recipes', newsItem: 'news' };
const page = view in parentPage ? await pageEntry(parentPage[view]) : (entry as CollectionEntry<'pages'>);
const menuFor: Partial<Record<string, PageKey>> = {
  product: 'products',
  recipe: 'recipes',
  newsItem: 'news',
  home: undefined,
};
const activeMenu = view in menuFor ? menuFor[view] : (view as PageKey);
const wide = ['home', 'products', 'product', 'recipe', 'contact', 'awards'].includes(view);

const products = ofLocale(await getCollection('products')).sort((a, b) => a.data.order - b.data.order);
const productBySlug = (slug?: string) => products.find((p) => slugOf(p) === slug);
const productUrl = (p: CollectionEntry<'products'>) => localeUrl(locale, `products/${slugOf(p)}/`);
const news = ofLocale(await getCollection('news')).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const recipes = ofLocale(await getCollection('recipes')).sort((a, b) => a.data.order - b.data.order);
const recipeUrl = (r: CollectionEntry<'recipes'>) => localeUrl(locale, `recipes/${slugOf(r)}/`);
const newsUrl = (n: CollectionEntry<'news'>) => localeUrl(locale, `news/${slugOf(n)}/`);
const productsPage = await pageEntry('products');
const gallery = await pageEntry('gallery');

// Awards: each entry's text is "year(s)" lines followed by "> result" lines; turned into a timeline by year
const awards = ofLocale(await getCollection('awards')).sort((a, b) => a.data.order - b.data.order);
const timeline = (() => {
  const rows: { year: string; title: string; result: string; url?: string }[] = [];
  for (const a of awards) {
    let years: string[] = [];
    for (const raw of (a.body ?? '').split('\n')) {
      const line = raw.trim();
      if (/^\d{4}([,\s]+\d{4})*$/.test(line)) years = line.split(/[,\s]+/);
      else if (line.startsWith('>') && years.length) {
        const result = line.replace(/^>\s*/, '').replace(/^\*|\*$/g, '').trim();
        for (const year of years) {
          const last = rows.findLast((r) => r.year === year && r.title === a.data.title);
          if (last) last.result += ` ${result}`;
          else rows.push({ year, title: a.data.title, result, url: a.data.url });
        }
      } else if (line && !line.startsWith('>')) years = [];
    }
  }
  const byYear = new Map<string, typeof rows>();
  for (const r of rows.sort((x, y) => Number(y.year) - Number(x.year))) {
    byYear.set(r.year, [...(byYear.get(r.year) ?? []), r]);
  }
  return [...byYear];
})();
const isTopResult = (s: string) => /šampion|prvak|champion|meister|campione|vincitore|primo posto|first place/i.test(s);

// Home page: the opening of the "about" story
const about = view === 'home' ? await pageEntry('about') : undefined;
const story = (() => {
  const text = plainText(about?.body).replace(/^(Kdo smo\?|Who are we\?)\s*/, '');
  const cut = text.indexOf('. ', 420);
  return cut > 0 ? text.slice(0, cut + 1) : text;
})();
const homeAwards = timeline.flatMap(([, rows]) => rows).slice(0, 6);

// Product page
const product = view === 'product' ? (entry as CollectionEntry<'products'>) : undefined;
const sizeLabels = product?.data.size?.split('/').map((s) => s.trim()) ?? [];
const categoryLabel = product
  ? { basic: t.categoryBasic, supplementary: t.categorySupplementary, gift: t.categoryGift }[product.data.category]
  : '';
const sameGroup = product
  ? products.filter((p) => p.data.category === product.data.category && p.id !== product.id)
  : [];
const recipesWithOil = product ? recipes.filter((r) => r.data.oil === slugOf(product)) : [];

// Recipe page
const recipe = view === 'recipe' ? (entry as CollectionEntry<'recipes'>) : undefined;
const recipeOil = productBySlug(recipe?.data.oil);

// FAQ: every question (### heading) becomes a section that opens on tap
const faqSections =
  view === 'faq'
    ? (entry.rendered?.html ?? '')
        .split(/(?=<h3[\s>])/)
        .map((part) => {
          const m = part.match(/^<h3[^>]*id="([^"]*)"[^>]*>([\s\S]*?)<\/h3>([\s\S]*)$/);
          return m ? { id: m[1], question: m[2], answer: m[3] } : { id: '', question: '', answer: part };
        })
    : [];

const title = entry.data.title;
const heading = product?.data.shortName ?? title;
---

<Base
  locale={locale}
  title={view === 'home' ? '' : heading}
  description={'description' in entry.data ? entry.data.description : undefined}
  alternates={alternates}
  activeMenu={activeMenu}
  sideImage={page.data.sideImage}
  layout={wide ? 'wide' : 'columns'}
>
  {
    view === 'home' && (
      <>
        <section class="hero">
          <div class="wrap">
            <div>
              <p class="eyebrow">{page.data.title}</p>
              <h1>{page.data.intro}</h1>
              <div class="actions">
                <a class="button" href={pageUrl(locale, 'products')}>
                  {t.ourOils}
                </a>
                <a class="button ghost" href={pageUrl(locale, 'contact')}>
                  {t.navContact}
                </a>
              </div>
              <p class="since">{t.since}</p>
            </div>
            {page.data.heroImage && (
              <figure class="framed">
                <img src={page.data.heroImage} alt="" width="800" height="600" />
              </figure>
            )}
          </div>
        </section>

        {page.data.harvestTitle && (
          <section class="harvest">
            <div class="wrap">
              <Sprig />
              <p>
                <strong>{page.data.harvestTitle}</strong> {page.data.harvestText}
              </p>
            </div>
          </section>
        )}

        <section class="story on-dark">
          <div class="wrap">
            <img src={page.data.sideImage} alt="" width="300" height="350" loading="lazy" />
            <div class="story-text">
              <h2>{t.navAbout}</h2>
              <p>{story}</p>
              <a class="more" href={pageUrl(locale, 'about')}>
                {t.aboutUs}
              </a>
            </div>
          </div>
        </section>

        <section class="band paper">
          <div class="wrap">
            <div class="band-head">
              <h2 class="section-title">
                <Sprig />
                {t.ourOils}
              </h2>
              <a class="more" href={pageUrl(locale, 'products')}>
                {t.allProducts}
              </a>
            </div>
            <Shelf locale={locale} items={products.filter((p) => p.data.category === 'basic' && p.data.taste)} />
          </div>
        </section>

        {page.data.photos && page.data.photos.length > 0 && (
          <section class="photo-strip">
            <div class="wrap">
              <h2 class="small-title">{t.photoStrip}</h2>
              <ul>
                {page.data.photos.map((src) => (
                  <li>
                    <a href={pageUrl(locale, 'gallery')}>
                      <img src={src} alt="" width="800" height="600" loading="lazy" />
                    </a>
                  </li>
                ))}
              </ul>
              <p class="right">
                <a class="more" href={pageUrl(locale, 'gallery')}>
                  {gallery?.data.title ?? t.galleryLink}
                </a>
              </p>
            </div>
          </section>
        )}

        <section class="band mid">
          <div class="wrap press">
            {page.data.highlightQuote && (
              <blockquote>
                <p class="quote">„{page.data.highlightQuote}“</p>
                {page.data.highlightText && <p>{page.data.highlightText}</p>}
                <cite>{page.data.highlightSource}</cite>
                <p>
                  <a class="more" href={pageUrl(locale, 'press')}>
                    {t.fromPress}
                  </a>
                </p>
              </blockquote>
            )}
            <div>
              <h2 class="small-title">{t.navAwards}</h2>
              <ul class="award-list">
                {homeAwards.map((a) => (
                  <li>
                    <span class="year">{a.year}</span>
                    <span>
                      {a.title}
                      <br />
                      <em>{a.result}</em>
                    </span>
                  </li>
                ))}
              </ul>
              <a class="more" href={pageUrl(locale, 'awards')}>
                {t.allAwards}
              </a>
            </div>
          </div>
        </section>

        <section class="band paper">
          <div class="wrap">
            <div class="band-head">
              <h2 class="section-title">
                <Sprig />
                {t.fromKitchen}
              </h2>
              <a class="more" href={pageUrl(locale, 'recipes')}>
                {t.allRecipes}
              </a>
            </div>
            <ul class="recipe-list cols">
              {recipes.slice(0, 8).map((r) => (
                <li>
                  <a href={recipeUrl(r)}>{r.data.title}</a>
                  {productBySlug(r.data.oil) && <span class="chip">{productBySlug(r.data.oil)!.data.shortName}</span>}
                </li>
              ))}
            </ul>
          </div>
        </section>

        <section class="visit on-dark">
          <div class="wrap">
            <div>
              <h2>{t.buyTitle}</h2>
              <p>{t.buyText}</p>
              <div class="links">
                <a href={`${pageUrl(locale, 'products')}#where-to-buy`}>{t.whereToBuy}</a>
                <a href={pageUrl(locale, 'contact')}>{t.directions}</a>
              </div>
            </div>
            <div class="actions">
              {CONTACT.phones.map((p) => (
                <a class="button" href={`tel:${p.tel}`}>
                  {t.call} {p.name} <small>{p.display}</small>
                </a>
              ))}
              <a class="button ghost" href={`mailto:${CONTACT.email}`}>
                {t.email}
              </a>
            </div>
          </div>
        </section>
      </>
    )
  }

  {
    view === 'products' && (
      <section class="band paper">
        <div class="wrap">
          <h1>{title}</h1>
          <ProductList locale={locale} />
          <hr />
          <div class="duo">
            <div class="prose">
              <Content />
            </div>
            {page.data.sidebar && (
              <aside class="buy-box on-dark" id="where-to-buy">
                <h2>{t.buyTitle}</h2>
                <div class="actions">
                  {CONTACT.phones.map((p) => (
                    <a class="button" href={`tel:${p.tel}`}>
                      {t.call} {p.name}
                    </a>
                  ))}
                </div>
                <div class="prose">
                  <Markdown text={page.data.sidebar} />
                </div>
              </aside>
            )}
          </div>
        </div>
      </section>
    )
  }

  {
    product && (
      <section class="band paper">
        <div class="wrap">
          <nav class="crumbs">
            <a href={pageUrl(locale, 'products')}>{t.navProductsShort}</a> / {categoryLabel}
          </nav>
          <article class="product">
            <div class="product-media">
              <div class="stage">
                {product.data.images.map((src, i) => (
                  <img src={src} alt={`${title} ${sizeLabels[i] ?? ''}`} hidden={i > 0} data-image={i} />
                ))}
              </div>
              {product.data.images.length > 1 && sizeLabels.length === product.data.images.length && (
                <div class="sizes">
                  <span class="small-title">{t.sizes}</span>
                  {sizeLabels.map((s, i) => (
                    <button type="button" data-show={i} aria-pressed={i === 0 ? 'true' : 'false'}>
                      {s}
                    </button>
                  ))}
                </div>
              )}
            </div>
            <div class="product-info">
              <p class="eyebrow">{categoryLabel}</p>
              <h1>{heading}</h1>
              <p class="product-sub">
                {product.data.shortName && <span>{title}</span>}
                {product.data.size && <span>{product.data.size}</span>}
              </p>
              <div class="prose">
                <Content />
              </div>
              {(product.data.aroma || product.data.flavour) && (
                <dl class="notes">
                  {product.data.aroma && (
                    <div>
                      <dt>{t.aroma}</dt>
                      <dd>{product.data.aroma}</dd>
                    </div>
                  )}
                  {product.data.flavour && (
                    <div>
                      <dt>{t.flavour}</dt>
                      <dd>{product.data.flavour}</dd>
                    </div>
                  )}
                </dl>
              )}
              {product.data.taste && <TasteProfile locale={locale} taste={product.data.taste} />}
              {product.data.pairings.length > 0 && (
                <section class="pairings">
                  <h2 class="small-title">{t.pairings}</h2>
                  <ul class="chips">
                    {product.data.pairings.map((p) => (
                      <li class="chip">{p}</li>
                    ))}
                  </ul>
                </section>
              )}
              {recipesWithOil.length > 0 && (
                <section class="pairings">
                  <h2 class="small-title">{t.recipesWithOil}</h2>
                  <ul class="recipe-list">
                    {recipesWithOil.map((r) => (
                      <li>
                        <a href={recipeUrl(r)}>{r.data.title}</a>
                      </li>
                    ))}
                  </ul>
                </section>
              )}
              <aside class="buy-box on-dark">
                <h2>{t.buyTitle}</h2>
                <p>{t.buyText}</p>
                <div class="actions">
                  {CONTACT.phones.map((p) => (
                    <a class="button" href={`tel:${p.tel}`}>
                      {t.call} {p.name} <small>{p.display}</small>
                    </a>
                  ))}
                  <a class="button ghost" href={`mailto:${CONTACT.email}`}>
                    {t.email}
                  </a>
                </div>
                {productsPage.data.sidebar && (
                  <details>
                    <summary>{t.whereToBuy}</summary>
                    <Markdown text={productsPage.data.sidebar} />
                  </details>
                )}
              </aside>
            </div>
          </article>

          {sameGroup.length > 0 && (
            <section class="related">
              <h2 class="section-title">
                <Sprig />
                {t.sameGroup}
              </h2>
              <Shelf locale={locale} items={sameGroup} />
            </section>
          )}
        </div>
        <script>
          document.querySelectorAll<HTMLButtonElement>('.sizes button').forEach((button) => {
            button.addEventListener('click', () => {
              const show = button.dataset.show;
              document.querySelectorAll<HTMLImageElement>('.stage img').forEach((img) => {
                img.hidden = img.dataset.image !== show;
              });
              document.querySelectorAll('.sizes button').forEach((b) => b.setAttribute('aria-pressed', String(b === button)));
            });
          });
        </script>
      </section>
    )
  }

  {
    recipe && (
      <section class="band paper">
        <div class="wrap">
          <nav class="crumbs">
            <a href={pageUrl(locale, 'recipes')}>{page.data.title}</a>
          </nav>
          <h1 class="recipe-title">{title}</h1>
          <div class="recipe">
            <aside class="ingredients">
              <h2 class="small-title">{t.ingredients}</h2>
              {recipe.data.servings && <p class="servings">{recipe.data.servings}</p>}
              <div class="ingredient-list">
                <Markdown text={recipe.data.ingredients} />
              </div>
            </aside>
            <div class="prose method">
              <h2 class="small-title">{t.preparation}</h2>
              <Content />
              <div class="recipe-foot">
                {recipeOil && (
                  <a class="oil-card" href={productUrl(recipeOil)}>
                    {recipeOil.data.images[0] && <img src={recipeOil.data.images[0]} alt="" />}
                    <span>
                      <span class="small-title">{t.bestWith}</span>
                      <span class="oil-name">{recipeOil.data.shortName ?? recipeOil.data.title}</span>
                    </span>
                  </a>
                )}
                <button type="button" class="button ghost print" onclick="window.print()">
                  {t.printRecipe}
                </button>
              </div>
            </div>
          </div>
        </div>
        <script>
          // tap an ingredient to tick it off while cooking
          document.querySelectorAll('.ingredient-list li').forEach((li) => {
            li.setAttribute('role', 'checkbox');
            li.setAttribute('aria-checked', 'false');
            li.setAttribute('tabindex', '0');
            const toggle = () => li.setAttribute('aria-checked', String(li.getAttribute('aria-checked') !== 'true'));
            li.addEventListener('click', toggle);
            li.addEventListener('keydown', (e) => {
              if ((e as KeyboardEvent).key === ' ' || (e as KeyboardEvent).key === 'Enter') {
                e.preventDefault();
                toggle();
              }
            });
          });
        </script>
      </section>
    )
  }

  {
    view === 'awards' && (
      <section class="band paper">
        <div class="wrap narrow">
          <h1>{title}</h1>
          <div class="prose">
            <Content />
          </div>
          <ul class="logo-row">
            {awards
              .filter((a) => a.data.logo)
              .map((a) => (
                <li>
                  {a.data.url ? (
                    <a href={a.data.url}>
                      <img src={a.data.logo} alt={a.data.title} />
                    </a>
                  ) : (
                    <img src={a.data.logo} alt={a.data.title} />
                  )}
                </li>
              ))}
          </ul>
          <ol class="timeline">
            {timeline.map(([year, rows]) => (
              <li>
                <span class="timeline-year">{year}</span>
                <ul>
                  {rows.map((r) => (
                    <li class:list={{ top: isTopResult(r.result) }}>
                      <span class="timeline-title">{r.title}</span>
                      <span class="timeline-result">{r.result.replace(/\*/g, '')}</span>
                    </li>
                  ))}
                </ul>
              </li>
            ))}
          </ol>
        </div>
      </section>
    )
  }

  {
    view === 'contact' && (
      <section class="band paper">
        <div class="wrap duo">
          <div>
            <h1>{title}</h1>
            <div class="prose address">
              <Content />
            </div>
            <div class="actions">
              {CONTACT.phones.map((p) => (
                <a class="button" href={`tel:${p.tel}`}>
                  {t.call} {p.name} <small>{p.display}</small>
                </a>
              ))}
              <a class="button ghost" href={`mailto:${CONTACT.email}`}>
                {t.email}
              </a>
            </div>
          </div>
          <div class="contact-side">
            <figure class="framed">
              <img src="/images/gallery/r-31-soncni-zahod.jpg" alt="" width="800" height="600" />
            </figure>
            <p>{t.buyText}</p>
          </div>
        </div>
        <div class="wrap contact-map">
          <ContactMap locale={locale} />
        </div>
      </section>
    )
  }

  {
    view === 'faq' && (
      <>
        <h1>{title}</h1>
        <div class="faq">
          {faqSections.map((s) =>
            s.question ? (
              <details id={s.id}>
                <summary set:html={s.question} />
                <div class="answer" set:html={s.answer} />
              </details>
            ) : (
              <Fragment set:html={s.answer} />
            ),
          )}
        </div>
        <script>
          // opening a question from a link (e.g. /faq/#question) unfolds it
          const open = () => {
            const target = location.hash && document.getElementById(decodeURIComponent(location.hash.slice(1)));
            if (target instanceof HTMLDetailsElement) target.open = true;
          };
          open();
          window.addEventListener('hashchange', open);
        </script>
      </>
    )
  }

  {
    view === 'gallery' && (
      <>
        <h1>{title}</h1>
        <Content />
        <Gallery locale={locale} images={page.data.images ?? []} />
      </>
    )
  }

  {
    view === 'recipes' && (
      <>
        <h1>{title}</h1>
        <Content />
        <ul class="recipe-list">
          {recipes.map((r) => (
            <li>
              <a href={recipeUrl(r)}>{r.data.title}</a>
              {productBySlug(r.data.oil) && <span class="chip">{productBySlug(r.data.oil)!.data.shortName}</span>}
            </li>
          ))}
        </ul>
      </>
    )
  }

  {
    view === 'news' && (
      <>
        <h1>{title}</h1>
        <Content />
        <ul class="item-list">
          {news.map((n) => (
            <li>
              <p class="eyebrow">{formatDate(n.data.date)}</p>
              <a class="item-title" href={newsUrl(n)}>
                {n.data.title}
              </a>
              <p>
                {excerpt(n.body, 200)} <a href={newsUrl(n)}>…</a>
              </p>
            </li>
          ))}
        </ul>
      </>
    )
  }

  {
    view === 'newsItem' && (
      <>
        <nav class="crumbs">
          <a href={pageUrl(locale, 'news')}>{page.data.title}</a> · {formatDate((entry as CollectionEntry<'news'>).data.date)}
        </nav>
        <h1>{title}</h1>
        <Content />
      </>
    )
  }

  {
    ['about', 'press', 'links'].includes(view) && (
      <>
        <h1>{title}</h1>
        <Content />
      </>
    )
  }
</Base>
