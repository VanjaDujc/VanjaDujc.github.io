---
// All products of a language, grouped by category, each group as a shelf.
import { getCollection } from 'astro:content';
import Shelf from './Shelf.astro';
import Sprig from './Sprig.astro';
import { splitId, ui, type Locale } from '../i18n';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = ui[locale];

const products = (await getCollection('products'))
  .filter((p) => splitId(p.id).locale === locale)
  .sort((a, b) => a.data.order - b.data.order);

const groups = [
  { category: 'basic', title: t.categoryBasic },
  { category: 'supplementary', title: t.categorySupplementary },
  { category: 'gift', title: t.categoryGift },
]
  .map((g) => ({ ...g, items: products.filter((p) => p.data.category === g.category) }))
  .filter((g) => g.items.length);
---

{
  groups.map((group) => (
    <section class="product-group">
      <h2 class="section-title">
        <Sprig />
        {group.title}
      </h2>
      <Shelf locale={locale} items={group.items} />
    </section>
  ))
}
