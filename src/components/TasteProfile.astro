---
// Fruitiness, bitterness and pungency shown as five olives each.
import { ui, type Locale } from '../i18n';

interface Props {
  locale: Locale;
  taste: { fruity: number; bitter: number; pungent: number };
}
const { locale, taste } = Astro.props;
const t = ui[locale];
const rows = [
  { label: t.tasteFruity, value: taste.fruity },
  { label: t.tasteBitter, value: taste.bitter },
  { label: t.tastePungent, value: taste.pungent },
];
---

<section class="taste">
  <h2 class="small-title">{t.taste}</h2>
  <dl>
    {
      rows.map((row) => (
        <div class="taste-row">
          <dt>{row.label}</dt>
          <dd aria-label={`${row.value} / 5`}>
            {[1, 2, 3, 4, 5].map((n) => (
              <svg viewBox="0 0 12 16" width="12" height="16" class:list={['olive', { on: n <= row.value }]} aria-hidden="true">
                <ellipse cx="6" cy="8.5" rx="4.6" ry="6" />
                <path d="M6 2.6 C 6.4 1.4, 7.4 0.8, 8.6 0.8" fill="none" />
              </svg>
            ))}
          </dd>
        </div>
      ))
    }
  </dl>
</section>
